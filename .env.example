# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Leave empty to run with high-performance In-Memory History mode
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sentiment_analyzer_db
MONGODB_COLLECTION_NAME=analysis_history

# Hugging Face Model Selection
# Default: cardiffnlp/twitter-roberta-base-sentiment-latest
# For low-resource environments (e.g. Render Free Tier 512MB RAM):
# MODEL_NAME=lxyuan/distilbert-base-multilingual-cased-sentiments-student
MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest

# Application Settings
PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret
